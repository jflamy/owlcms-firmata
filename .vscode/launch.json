{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "🔷 firmata",
      "request": "launch",
      "console": "internalConsole",
      "mainClass": "app.owlcms.firmata.ui.Main",
      "projectName": "owlcms-firmata",
      "cwd": "${workspaceFolder}",
      "vmArgs": "${config:owlcms.vmArgs}",
      "windows": {
        "envFile": "${workspaceFolder}\\.vscode\\.env.windows"
      },
      "linux": {
        "envFile": "${workspaceFolder}/.vscode/.env.linux"
      },
      "osx": {
        "envFile": "${workspaceFolder}/.vscode/.env.mac"
      },
      "env": {
        "OWLCMS_MEMORYMODE": "false"
      }
    },
    {
      "type": "java",
      "name": "🔷 firmata (control panel mode)",
      "request": "launch",
      "console": "internalConsole",
      "mainClass": "app.owlcms.firmata.ui.Main",
      "projectName": "owlcms-firmata",
      "cwd": "${workspaceFolder}",
      "vmArgs": "${config:owlcms.vmArgs}",
      "windows": {
        "envFile": "${workspaceFolder}\\.vscode\\.env.windows"
      },
      "linux": {
        "envFile": "${workspaceFolder}/.vscode/.env.linux"
      },
      "osx": {
        "envFile": "${workspaceFolder}/.vscode/.env.mac"
      },
      "env": {
        "OWLCMS_MEMORYMODE": "false",
        "OWLCMS_CONTROLPANEL": "3.0.0"
      }
    },
    {
      "type": "java",
      "name": "Launch - Current File",
      "request": "launch",
      "console": "internalConsole",
      "mainClass": "${file}",
      "vmArgs": "${config:owlcms.vmArgs}"
    }
  ]
}
